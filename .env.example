# Copy this file to .env and fill in real values for your local environment.
# NEVER commit .env or any file containing real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:8080
APP_NAME=BizPilot AI

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PGVector)
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/bizpilot
DB_USERNAME=bizpilot
DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# JWT / Authentication
# ---------------------------------------------------------------------------
# Generate a strong random secret for JWT_SECRET (e.g. `openssl rand -base64 64`).
# Never reuse this value across environments.
JWT_SECRET=changeme-generate-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ---------------------------------------------------------------------------
# AI Provider (Spring AI) - configure only the provider(s) in use
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
# One of: openai, anthropic, google-gemini, ollama

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Redis (caching, rate limiting)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------------------------------------------------------------
# Storage (documents)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
# One of: local, s3

STORAGE_LOCAL_PATH=./data/uploads

STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (Vite) - exposed to the browser bundle, no secrets here
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
