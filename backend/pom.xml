<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.bizpilot</groupId>
    <artifactId>bizpilot-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>bizpilot-backend</name>
    <description>BizPilot AI backend — AI-powered business operations platform for SMBs</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.13.0</jjwt.version>
        <pdfbox.version>3.0.3</pdfbox.version>
        <!-- Phase 14: the last Spring AI line still built/tested against Spring
             Boot 3.4.x/3.5.x — Spring AI 2.x requires Spring Boot 4, which this
             project does not use. Locked decision; do not bump to 2.x without
             also deciding to upgrade Spring Boot. -->
        <spring-ai.version>1.1.8</spring-ai.version>
        <!-- Phase 15: DOCX text extraction only (CLAUDE.md §16/§17) — not managed
             by spring-boot-starter-parent's own dependency management, so pinned
             explicitly here, the same way pdfbox.version already is. -->
        <poi.version>5.5.1</poi.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / REST foundation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation, for future request DTO validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Health checks / observability foundation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Database: Spring Data JPA / Hibernate, PostgreSQL driver, Flyway migrations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Security: Spring Security + JWT (access tokens) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Quotation PDF generation (CLAUDE.md §14, Phase 10) — Apache 2.0 licensed,
             no problematic transitive dependencies (pdfbox-io, fontbox, commons-logging only). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Spring AI foundation (CLAUDE.md §5, Phase 14) — OpenAI is the
             configured PRODUCTION provider (its starter is the only one
             providing both ChatModel and EmbeddingModel from one artifact/one
             API key). No Anthropic/Google starter, no vector database client
             beyond PGVector below — those remain explicitly out of scope.
             Version managed entirely by the spring-ai-bom import above. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Local-chat-only Ollama support (read-only investigation +
             locked-scope implementation, see docs/architecture.md/security.md
             for the full config contract) — a second, independently-selectable
             chat provider for local development against a developer's own
             Ollama server, never the default and never used in production.
             Spring AI's own spring.ai.model.chat selector (application.yml)
             decides which of this starter's or the OpenAI starter's
             ChatModel/ChatClient.Builder bean actually activates; no BizPilot
             Java code branches on provider name. Deliberately NOT adding an
             embedding model or PGVector configuration for Ollama — local RAG
             is explicitly out of scope for this change; only
             DefaultAiChatService's ChatClient.Builder is ever exercised via
             this starter today. Version managed entirely by the spring-ai-bom
             import above — verified directly against the cached
             spring-ai-bom-1.1.8.pom that this exact artifact is managed at
             1.1.8, not a newer/mismatched version. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!-- Phase 15: RAG foundation (CLAUDE.md §17, §6) — Spring AI's PGVector
             VectorStore, same 1.1.8 BOM already pinned above. Flyway (not Spring
             AI's own schema initializer) owns the vector_store table — see
             V12__create_document_chunks_and_vector_store.sql and
             spring.ai.vectorstore.pgvector.initialize-schema=false in
             application.yml. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- DOCX text extraction only (CLAUDE.md §16/§17, Phase 15) — the
             minimal Apache POI modules needed for .docx (OOXML WordprocessingML)
             text extraction; no spreadsheet (poi-ooxml handles both, but only
             XWPF/.docx APIs are used), no OCR, no Apache Tika (a much larger,
             format-detecting dependency this narrow, three-fixed-format need
             doesn't justify — mirrors the PDFBox-over-Tika reasoning from
             Phase 10). -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>bizpilot-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
