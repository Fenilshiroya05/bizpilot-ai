<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-scoped Maven settings for BizPilot AI (a personal, non-Valtech-client project).

  This repository intentionally builds against public Maven Central rather than
  the Valtech corporate Nexus mirror configured in the machine's global
  ~/.m2/settings.xml, which is scoped to client/internal work and does not
  proxy open-source artifacts used here. This file is picked up automatically
  via .mvn/maven.config and does not modify any global/user Maven configuration.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
</settings>
